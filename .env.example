# ─── Slack ───────────────────────────────────────────────────
# From your Slack App dashboard → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# From your Slack App dashboard → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-here

# The Slack channel ID where design updates are posted (e.g. #design-tracker)
# Right-click the channel in Slack → Copy Link → the ID is at the end of the URL
SLACK_NOTIFICATION_CHANNEL=C07CTMUN66M

# ─── Notion ──────────────────────────────────────────────────
# From Notion → Settings → Connections → Develop or manage integrations
NOTION_API_KEY=secret_your-notion-integration-token-here

# The Africhange Design Tracker database ID (already created)
NOTION_DATABASE_ID=67bace18-43da-46c2-8d9d-580a3dd20f90

# ─── Server ──────────────────────────────────────────────────
# Railway sets this automatically — do not change in production
PORT=3000
